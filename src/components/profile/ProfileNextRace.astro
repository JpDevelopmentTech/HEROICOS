---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';

const photo = '/images/perfil-hero.jpg';

const countdown = [
  { value: '143', label: 'DÍAS', labelLg: 'DÍAS' },
  { value: '06', label: 'HORAS', labelLg: 'HORAS' },
  { value: '12', label: 'MIN', labelLg: 'MINUTOS' },
  { value: '48', label: 'SEG', labelLg: 'SEGUNDOS' },
];

const curve = [8, 12, 18, 26, 36, 48, 60, 72, 84, 94, 88, 76, 64, 52, 40, 30, 22, 16, 11, 7];
const peak = Math.max(...curve);
const youAt = 17;

const comparisons = [
  { label: 'Ritmo promedio', you: '4:38 /km', avg: '5:12 /km' },
  { label: 'Km por semana', you: '32 km', avg: '19 km' },
  { label: 'Carreras al año', you: '9', avg: '4' },
];
---

<section class="bg-dark-950 px-5 py-11 md:px-20 md:py-24">
  <div class="flex flex-col gap-5 md:gap-11">
    <SectionHead eyebrow="PRÓXIMA META" title="Lo que viene." />

    <div class="flex flex-col gap-5 xl:flex-row xl:items-start md:gap-6">
      <!-- Próxima carrera -->
      <article class="relative flex min-w-0 flex-1 flex-col overflow-hidden rounded-lg border border-dark-750 bg-dark-900 xl:flex-row">
        <div class="relative h-[150px] w-full shrink-0 overflow-hidden md:h-[220px] xl:h-auto xl:w-[300px]">
          <img src={photo} alt="" class="h-full w-full object-cover" />
          <div class="absolute inset-0 bg-[#0B2731] mix-blend-color" aria-hidden="true"></div>
          <div
            class="absolute inset-0 bg-gradient-to-b from-dark-950/20 to-dark-900/95 xl:bg-gradient-to-r xl:from-transparent xl:to-dark-900/90"
            aria-hidden="true"
          >
          </div>
        </div>

        <!-- Dorsal asignado (móvil sobre la foto, desktop en la cabecera) -->
        <div
          class="absolute right-4 top-4 flex flex-col items-end gap-0.5 rounded-[5px] border border-white/15 bg-dark-950/80 px-3 py-2 xl:hidden"
        >
          <span class="font-body text-[8px] font-bold tracking-[1.5px] text-gray-400">TU DORSAL</span>
          <span class="font-display text-2xl font-bold leading-none text-accent">1847</span>
        </div>

        <div class="flex min-w-0 flex-1 flex-col gap-4 p-[18px] md:gap-[22px] md:p-8">
          <header class="flex items-start justify-between gap-4">
            <div class="flex flex-col gap-1.5 md:gap-2">
              <span class="font-body text-[9px] font-bold tracking-[1.8px] text-[#22C55E] md:text-[10px] md:tracking-[2px]">
                INSCRIPCIÓN CONFIRMADA
              </span>
              <h3 class="font-heading text-[22px] font-bold leading-tight tracking-[-0.5px] text-white md:text-[30px]">
                Maratón de Bogotá 2027
              </h3>
              <p class="font-body text-xs leading-relaxed text-gray-400 md:text-[13px]">
                18 de julio · 6:00 a.m. · Parque Simón Bolívar
              </p>
            </div>
            <div class="hidden flex-col items-end gap-1 rounded-md border border-dark-750 bg-white/[0.03] px-3.5 py-2.5 xl:flex">
              <span class="font-body text-[9px] font-bold tracking-[1.5px] text-gray-500">TU DORSAL</span>
              <span class="font-display text-[28px] font-bold leading-none text-accent">1847</span>
            </div>
          </header>

          <hr class="border-dark-800" />

          <div class="flex flex-col gap-2.5 md:gap-3.5">
            <span class="font-body text-[9px] font-bold tracking-[1.8px] text-gray-500 md:text-[10px] md:tracking-[2px]">
              FALTAN
            </span>
            <div class="flex gap-2 md:gap-3">
              {
                countdown.map((c) => (
                  <div class="flex flex-1 flex-col items-center gap-0.5 rounded-md border border-dark-750 bg-dark-950 py-3 md:gap-1 md:py-4">
                    <span class="font-display text-[30px] font-bold leading-none text-white md:text-[40px]">
                      {c.value}
                    </span>
                    <span class="font-body text-[8px] font-bold tracking-[1.2px] text-gray-500 md:text-[9px] md:tracking-[1.5px]">
                      <span class="md:hidden">{c.label}</span>
                      <span class="hidden md:inline">{c.labelLg}</span>
                    </span>
                  </div>
                ))
              }
            </div>
          </div>

          <div class="flex flex-col gap-2.5 md:flex-row md:gap-3">
            <button
              type="button"
              class="flex cursor-pointer items-center justify-center gap-2 rounded bg-accent py-3.5 font-body text-[11px] font-bold tracking-[1.2px] text-dark-950 transition-opacity hover:opacity-90 md:px-[22px] md:py-3 md:text-xs md:tracking-[1.5px]"
            >
              <Icon name="calendar-check" size={15} class="md:h-4 md:w-4" />
              PLAN DE 12 SEMANAS
            </button>
            <button
              type="button"
              class="flex cursor-pointer items-center justify-center gap-2 rounded border border-dark-750 bg-white/[0.03] py-3.5 font-body text-[11px] font-bold tracking-[1.2px] text-white transition-colors hover:border-gray-600 md:px-[22px] md:py-3 md:text-xs md:tracking-[1.5px]"
            >
              <Icon name="map" size={15} class="md:h-4 md:w-4" />
              VER RECORRIDO
            </button>
          </div>
        </div>
      </article>

      <!-- Comparativa -->
      <aside
        class="flex flex-col gap-[18px] rounded-lg border border-dark-750 bg-dark-900 p-5 xl:w-[400px] xl:shrink-0 md:gap-[22px] md:p-[30px]"
      >
        <div class="flex items-center gap-[7px] md:gap-2">
          <Icon name="users" size={13} class="text-accent md:h-3.5 md:w-3.5" />
          <span class="font-body text-[9px] font-bold tracking-[2px] text-accent md:text-[10px]">
            TU LUGAR EN LA MANADA
          </span>
        </div>

        <div class="flex flex-col gap-1.5">
          <span class="font-display text-[44px] font-bold leading-none text-white md:text-[52px]">TOP 8%</span>
          <span class="font-body text-xs leading-relaxed text-gray-400 md:text-[13px]">
            de 2.140 corredores 30-34 en Bolívar
          </span>
        </div>

        <div>
          <div class="flex h-12 items-end gap-[3px] md:h-14">
            {
              curve.map((v, i) => (
                <div
                  class:list={['flex-1 rounded-t-[2px]', i === youAt ? 'bg-accent' : 'bg-dark-750']}
                  style={`height: ${Math.round((v / peak) * 100)}%`}
                />
              ))
            }
          </div>
          <p class="mt-2.5 text-right font-body text-[10px] font-semibold text-accent md:text-[11px]">
            Tu marca de 10K está aquí ↑
          </p>
        </div>

        <hr class="border-dark-800" />

        <div class="flex flex-col gap-3.5 md:gap-4">
          {
            comparisons.map((c) => (
              <div class="flex flex-col gap-[7px] md:gap-2">
                <span class="font-body text-[10px] font-semibold text-gray-500 md:text-[11px]">{c.label}</span>
                <div class="flex items-center justify-between gap-3">
                  <span class="flex items-center gap-1.5 md:gap-[7px]">
                    <span class="h-1.5 w-1.5 rounded-full bg-accent" />
                    <span class="font-body text-[13px] font-bold text-white md:text-sm">Tú {c.you}</span>
                  </span>
                  <span class="flex items-center gap-1.5 md:gap-[7px]">
                    <span class="h-1.5 w-1.5 rounded-full bg-gray-600" />
                    <span class="font-body text-xs font-medium text-gray-500 md:text-[13px]">Media {c.avg}</span>
                  </span>
                </div>
              </div>
            ))
          }
        </div>

        <hr class="border-dark-800" />

        <div class="flex items-center justify-between">
          <span class="font-body text-xs font-semibold text-gray-200 md:text-[13px]">Ranking Club Heroicos</span>
          <span class="flex items-center gap-1.5">
            <Icon name="trending-up" size={13} class="text-[#22C55E] md:h-3.5 md:w-3.5" />
            <span class="font-display text-lg font-bold text-white md:text-xl">4º de 218</span>
          </span>
        </div>
      </aside>
    </div>
  </div>
</section>
