---
import Icon from './Icon.astro';

const items = [
  { icon: 'house', label: 'Inicio', href: '/', active: false },
  { icon: 'flag', label: 'Carreras', href: '/#rutas', active: false },
  { icon: 'trophy', label: 'Ranking', href: '/#comunidad', active: false },
  { icon: 'user', label: 'Perfil', href: '/profile', active: true },
];
---

<nav
  class="fixed inset-x-0 bottom-0 z-40 flex items-center justify-between border-t border-dark-800 bg-dark-950/95 px-5 pb-[22px] pt-2.5 backdrop-blur-md md:hidden"
  aria-label="Navegación principal"
>
  <a href={items[0].href} class="flex flex-col items-center gap-1.5 px-2.5 py-1 text-gray-500">
    <Icon name={items[0].icon} size={21} />
    <span class="font-body text-[9px] font-semibold tracking-[0.5px]">{items[0].label}</span>
  </a>
  <a href={items[1].href} class="flex flex-col items-center gap-1.5 px-2.5 py-1 text-gray-500">
    <Icon name={items[1].icon} size={21} />
    <span class="font-body text-[9px] font-semibold tracking-[0.5px]">{items[1].label}</span>
  </a>

  <span class="flex h-[50px] w-[50px] shrink-0 items-center justify-center rounded-full bg-accent text-dark-950">
    <Icon name="plus" size={24} strokeWidth={2.5} />
  </span>

  <a href={items[2].href} class="flex flex-col items-center gap-1.5 px-2.5 py-1 text-gray-500">
    <Icon name={items[2].icon} size={21} />
    <span class="font-body text-[9px] font-semibold tracking-[0.5px]">{items[2].label}</span>
  </a>
  <a href={items[3].href} class="flex flex-col items-center gap-1.5 px-2.5 py-1 text-accent">
    <Icon name={items[3].icon} size={21} />
    <span class="font-body text-[9px] font-semibold tracking-[0.5px]">{items[3].label}</span>
  </a>
</nav>
