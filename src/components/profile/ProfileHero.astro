---
import Icon from './Icon.astro';

const photo = '/images/perfil-hero.jpg';
const runner = {
  firstName: 'JESUS',
  lastName: 'PINEDA',
  motto: '«Corro de noche porque es cuando nadie me ve rendirme.»',
  bib: '1847',
  bibRace: '21K · CARTAGENA',
  level: 7,
  levelProgress: 78,
};

const chips = [
  { icon: 'map-pin', label: 'Cartagena, Colombia', short: 'Cartagena' },
  { icon: 'users', label: 'Escuadrón Norte', short: 'Escuadrón Norte' },
  { icon: 'calendar', label: 'Desde 2021', short: '2021' },
];

const ringMask =
  'radial-gradient(farthest-side, transparent calc(100% - 11px), #000 calc(100% - 11px))';
---

<section class="relative h-[600px] w-full overflow-hidden bg-dark-950 md:h-[820px]">
  <!-- Telón de fondo: la misma foto difuminada, solo en desktop -->
  <div class="absolute inset-0 hidden md:block" aria-hidden="true">
    <img src={photo} alt="" class="h-full w-full scale-[1.15] object-cover blur-[56px]" />
    <div class="absolute inset-0 bg-[#0B2731] mix-blend-color"></div>
    <div class="absolute inset-0 bg-dark-950/85"></div>
  </div>

  <!-- Foto del corredor -->
  <div class="absolute inset-0 overflow-hidden md:left-auto md:right-0 md:w-[640px]">
    <img
      src={photo}
      alt={`${runner.firstName} ${runner.lastName}`}
      class="h-full w-full object-cover object-center"
    />
    <!-- Duotono de marca: unifica cualquier foto que suba el corredor -->
    <div class="absolute inset-0 bg-[#0B2731] opacity-40 mix-blend-color" aria-hidden="true"></div>
    <div
      class="absolute inset-0 mix-blend-overlay"
      style="background: radial-gradient(60% 60% at 72% 28%, rgba(0,240,255,0.24) 0%, rgba(0,240,255,0) 100%)"
      aria-hidden="true"
    >
    </div>
    <!-- Fundidos que derriten la foto contra el fondo -->
    <div
      class="absolute inset-y-0 left-0 hidden w-[360px] bg-gradient-to-l from-transparent to-dark-950 md:block"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute inset-x-0 top-0 h-[140px] bg-gradient-to-b from-dark-950/80 to-transparent md:h-[180px]"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute inset-x-0 bottom-0 h-[460px] bg-gradient-to-b from-transparent via-dark-950/95 to-dark-950 md:h-[360px]"
      aria-hidden="true"
    >
    </div>
  </div>

  <!-- Dorsal -->
  <div
    class="absolute right-5 top-6 w-[138px] -rotate-3 rounded-[5px] bg-[#F7F5EF] px-3 pb-2 pt-2.5 shadow-2xl shadow-black/60 md:left-[626px] md:right-auto md:top-14 md:w-[310px] md:rounded-md md:px-5 md:pb-3.5 md:pt-[18px]"
  >
    <!-- Perforaciones de imperdible -->
    <span class="absolute left-2.5 top-2 h-2 w-2 rounded-full bg-dark-950/10 md:left-5 md:top-4 md:h-3 md:w-3"></span>
    <span class="absolute right-2.5 top-2 h-2 w-2 rounded-full bg-dark-950/10 md:right-5 md:top-4 md:h-3 md:w-3"></span>
    <span class="absolute bottom-2 left-2.5 h-2 w-2 rounded-full bg-dark-950/10 md:bottom-4 md:left-5 md:h-3 md:w-3"></span>
    <span class="absolute bottom-2 right-2.5 h-2 w-2 rounded-full bg-dark-950/10 md:bottom-4 md:right-5 md:h-3 md:w-3"></span>

    <p class="text-center font-display text-[10px] font-bold tracking-[3px] text-dark-950 md:text-base md:tracking-[5px]">
      HEROICOS GAMES
    </p>
    <hr class="mt-1 border-dark-950/15" />
    <p class="text-center font-display text-[62px] font-bold leading-none tracking-[-2px] text-dark-950 md:text-[140px] md:tracking-[-4px]">
      {runner.bib}
    </p>
    <hr class="border-dark-950/15" />
    <div class="flex items-center justify-center gap-1.5 pt-1.5 md:justify-between md:pt-2.5">
      <span class="h-[5px] w-[5px] rounded-full bg-dark-950 md:hidden"></span>
      <span class="font-display text-[10px] font-semibold tracking-[1.5px] text-gray-500 md:text-[15px] md:tracking-[2px]">
        {runner.bibRace}
      </span>
      <span class="hidden items-center gap-1.5 rounded-sm bg-dark-950 px-2.5 py-1 md:flex">
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
        <span class="font-body text-[10px] font-bold tracking-[1.5px] text-accent">CHIP ACTIVO</span>
      </span>
    </div>
  </div>

  <!-- Anillo de nivel (desktop) -->
  <div class="absolute bottom-[66px] right-20 hidden h-[172px] w-[172px] md:block">
    <div
      class="h-full w-full rounded-full"
      style={`background: conic-gradient(#00F0FF 0 ${runner.levelProgress}%, rgba(255,255,255,0.16) ${runner.levelProgress}% 100%); -webkit-mask: ${ringMask}; mask: ${ringMask};`}
      aria-hidden="true"
    >
    </div>
    <div class="absolute inset-0 flex flex-col items-center justify-center">
      <span class="font-body text-[10px] font-bold tracking-[4px] text-gray-300">NIVEL</span>
      <span class="font-display text-[66px] font-bold leading-none text-white">{runner.level}</span>
      <span class="font-body text-[9px] font-bold tracking-[1.5px] text-accent">
        {runner.levelProgress}% A NIVEL {runner.level + 1}
      </span>
    </div>
  </div>

  <!-- Identidad -->
  <div class="relative flex h-full flex-col justify-end px-5 pb-6 md:px-20 md:pb-[60px]">
    <div class="flex max-w-[660px] flex-col gap-4 md:gap-6">
      <div class="flex items-center gap-2.5 md:gap-3.5">
        <span class="block h-0.5 w-6 bg-accent md:w-9"></span>
        <span class="font-body text-[10px] font-bold tracking-[2px] text-accent md:text-xs md:tracking-[3px]">
          PASAPORTE HEROICO · TEMPORADA 2026
        </span>
      </div>

      <h1 class="font-heading text-[44px] font-extrabold leading-[0.94] tracking-[-1.5px] text-white md:text-[84px] md:leading-[0.92] md:tracking-[-2.5px]">
        {runner.firstName}<br />{runner.lastName}
      </h1>

      <p class="max-w-[520px] font-heading text-[13px] italic leading-relaxed text-gray-300 md:text-base">
        {runner.motto}
      </p>

      <div class="flex flex-wrap items-center gap-2 md:gap-2.5">
        {
          chips.map((chip) => (
            <span class="flex items-center gap-1.5 rounded-full border border-white/15 bg-white/[0.08] px-2.5 py-[7px] md:gap-2 md:px-3.5 md:py-2.5">
              <Icon name={chip.icon} size={12} class="text-gray-200 md:h-[15px] md:w-[15px]" />
              <span class="font-body text-[11px] font-medium text-gray-200 md:text-[13px]">
                <span class="md:hidden">{chip.short}</span>
                <span class="hidden md:inline">{chip.label}</span>
              </span>
            </span>
          ))
        }
      </div>

      <div class="flex items-center gap-2.5 md:gap-3">
        <button
          type="button"
          class="flex flex-1 cursor-pointer items-center justify-center gap-2 rounded bg-accent px-0 py-3.5 font-body text-xs font-bold tracking-[1.2px] text-dark-950 transition-opacity hover:opacity-90 md:flex-none md:gap-2.5 md:px-[22px] md:py-3 md:text-[13px] md:tracking-[1.5px]"
        >
          <Icon name="share-2" size={16} />
          COMPARTIR PERFIL
        </button>
        <button
          type="button"
          class="flex h-[46px] w-[46px] cursor-pointer items-center justify-center gap-2.5 rounded border border-white/20 bg-white/[0.08] text-white transition-colors hover:border-white/40 md:h-auto md:w-auto md:px-[22px] md:py-3"
        >
          <Icon name="pencil" size={17} class="md:h-4 md:w-4" />
          <span class="hidden font-body text-[13px] font-bold tracking-[1.5px] md:inline">EDITAR</span>
        </button>
        <button
          type="button"
          class="flex h-[46px] w-[46px] cursor-pointer items-center justify-center gap-2.5 rounded border border-white/20 bg-white/[0.08] text-white transition-colors hover:border-white/40 md:h-auto md:w-auto md:px-[22px] md:py-3"
        >
          <Icon name="download" size={17} class="md:h-4 md:w-4" />
          <span class="hidden font-body text-[13px] font-bold tracking-[1.5px] md:inline">DIPLOMA</span>
        </button>
      </div>
    </div>
  </div>
</section>
