---
/**
 * Tarjeta de membresía HEROICOS x AmaLife — tarjeta giratoria (pivota
 * sobre su esquina inferior izquierda, en bucle infinito) a la izquierda
 * + lista de beneficios a la derecha.
 *
 * Extraído de heroicosXamalife.astro para vivir como sección independiente.
 *
 * El apartado de beneficios (columna derecha) lista los descuentos y
 * beneficios propios de la tarjeta HEROICOS.
 */

const discountBenefits = [
  { name: 'AmaLife', percent: 20 },
  { name: 'Kinestrong', percent: 10 },
  { name: 'Pabblos', percent: 10 },
  { name: 'La Solar', percent: 10 },
];

const extraBenefits = [
  {
    title: 'Hidratación',
    desc: 'En las rutas de entrenamiento.',
  },
  {
    title: 'Entrenamientos de fortalecimiento y técnica',
    desc: 'Lunes y jueves.',
  },
];
---

<section
  id="heroicos-amalife-card"
  class="relative flex flex-col items-center gap-6 bg-dark-950/55 px-5 py-10 backdrop-blur-2xl md:gap-8 md:px-20 md:py-14"
>
  <h2 class="w-full max-w-[1920px] text-center font-heading text-2xl font-extrabold italic leading-none tracking-[-1px] text-white md:text-4xl md:tracking-[-1.5px]">
    - TARJETA HEROICOS -
  </h2>

  <div class="grid w-full max-w-350 items-center gap-8 md:grid-cols-2 md:gap-20">
    <!-- Tarjeta giratoria -->
    <div class="relative flex items-center justify-center py-8 md:justify-start md:py-24" data-reveal>
      <div
        class="pointer-events-none absolute left-1/2 top-1/2 h-56 w-56 -translate-x-1/2 -translate-y-1/2 rounded-full bg-white/10 blur-[70px] md:-left-16 md:h-95 md:w-95 md:translate-x-0 md:blur-[110px]"
      >
      </div>

      <div class="relative col-span-1 flex w-full rotate-0 items-center justify-center md:rotate-45 md:justify-start">
        <div class="w-full" style="perspective: 3600px;">
          <img
            src="/images/HEROICOSCARD.png"
            alt="Tarjeta de membresía HEROICOS"
            class="card-spin w-full max-w-50 rounded-2xl shadow-[0_20px_50px_-15px_rgba(0,0,0,0.7)] sm:max-w-65 md:max-w-95"
          />
        </div>
      </div>
    </div>

    <!-- Beneficios de la tarjeta HEROICOS -->
    <div class="col-span-1 flex flex-col gap-6" data-reveal-group data-reveal-stagger="0.1">
      <div class="rounded-xl border border-white/10 bg-white/5 p-4 backdrop-blur-xl md:p-8" data-reveal>
        <span class="font-body text-sm font-bold tracking-[2px] text-accent">
          TARJETA HEROICOS
        </span>
        <div class="mt-3 flex flex-wrap items-baseline gap-2">
          <span class="font-heading text-3xl font-extrabold tracking-[-1px] text-white md:text-5xl">
            $60.000
          </span>
          <span class="font-body text-base text-gray-400">COP</span>
        </div>
      </div>

      <div class="flex flex-col gap-3" data-reveal>
        <span class="font-body text-sm font-bold tracking-[2px] text-accent">DESCUENTOS CON ALIADOS</span>
        <div class="flex flex-wrap gap-2">
          {discountBenefits.map((d) => (
            <span class="inline-flex items-center gap-2 rounded-full bg-white/5 px-4 py-2 ring-1 ring-white/10">
              <span class="font-heading text-lg font-extrabold text-accent">{d.percent}%</span>
              <span class="font-body text-sm font-semibold text-white">{d.name}</span>
            </span>
          ))}
        </div>
      </div>

      <ul class="flex flex-col gap-3">
        {extraBenefits.map((b) => (
          <li class="flex items-start gap-3" data-reveal>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="mt-0.5 shrink-0 text-emerald-400"
            >
              <path d="M20 6 9 17l-5-5" />
            </svg>
            <span class="text-base">
              <strong class="font-semibold text-white">{b.title}</strong>
              <span class="text-gray-400"> — {b.desc}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
