---
import SectionLabel from './ui/SectionLabel.astro';

/**
 * HEROICOS x AmaLife — bloque de alianza en la página principal.
 *
 * En el index solo se muestra el label "ALIANZA", el título y el botón;
 * el contenido completo de la alianza vive en la página /alianza.
 *
 * Mantiene el mismo formato de sección que MetricsSection / ProfileSection
 * (flex-col centrado, mismo padding, mismo cristal) para que se lean como
 * un solo bloque continuo.
 */
---

<section
  id="heroicos-amalife"
  class="flex flex-col items-center gap-8 bg-dark-950/55 px-5 py-14 backdrop-blur-2xl md:gap-12 md:px-[120px] md:py-20"
>
  <SectionLabel text="ALIANZA" />

  <div
    class="flex flex-col items-center gap-6 text-center md:gap-8"
    data-reveal-group
    data-reveal-stagger="0.1"
  >
    <h2
      class="flex items-center gap-3 font-heading text-2xl font-extrabold tracking-[-1px] md:gap-4 md:text-4xl"
      data-reveal
    >
      <span class="text-white">HEROICOS</span>
      <span class="font-light text-gray-500">×</span>
      <span class="bg-gradient-to-r from-emerald-500 to-orange-400 bg-clip-text text-transparent">AmaLife</span>
    </h2>

    <!-- Botón: blanco por defecto, colores AmaLife en hover -->
    <a
      href="/alianza"
      class="group inline-flex items-center gap-3 rounded-full bg-white px-8 py-4 font-heading text-[13px] font-bold tracking-[1.5px] text-dark-950 transition-all duration-300 hover:-translate-y-0.5 hover:bg-emerald-600 hover:text-white hover:shadow-[0_14px_40px_-12px_rgba(5,150,105,0.65),0_0_0_4px_rgba(249,115,22,0.3)]"
      data-reveal
    >
      <span>DESCUBRE LA ALIANZA</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="transition-transform duration-300 group-hover:translate-x-1"
      >
        <path d="M5 12h14M12 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</section>
